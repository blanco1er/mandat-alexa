{"result":{"contents":[{"uri":"ui://mandat/plan-f89d492895.html","mimeType":"text/html;profile=mcp-app","_meta":{"ui":{"csp":{"connectDomains":[],"resourceDomains":[]},"prefersBorder":false}},"text":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Mandat plan</title>\n<style>/* Mandat cards (MCP Apps views).\n   Alexa+ add-on design guide: glanceable from across the room (one title, one or two supporting fields, one clear\n   action), text sized for distance (x1.6 over the 768x480 base canvas), voice and screen say the same thing.\n   Visual language: the team design system (design-system/DESIGN.md, Apple HIG 2026): system type, hierarchy by size\n   and weight only (no spaced capitals), one accent for the one action, status = dot + words, hairline separators,\n   spring motion on state changes only. Type scales with the card's own width (vw = the iframe), so a card reads the\n   same on Echo Show 8 and 15. Theme comes from the host (hostContext.theme); without a host it follows the system.\n   Fully inline: no fonts, images or scripts from anywhere else (empty CSP lists). */\n:root {\n  --font: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro Text\", system-ui, \"Segoe UI Variable Display\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  /* --k: set by the bridge when the host's containerDimensions.maxHeight is smaller than the card (auto-fit) */\n  --t-meta: calc(clamp(13px, 1.72vw, 33px) * var(--k, 1));\n  --t-body: calc(clamp(15px, 2.12vw, 41px) * var(--k, 1));\n  --t-title: calc(clamp(20px, 3.15vw, 60px) * var(--k, 1));\n  --t-num: calc(clamp(28px, 4.9vw, 94px) * var(--k, 1));\n  --pad: calc(clamp(16px, 2.5vw, 48px) * var(--k, 1));\n  --gap: calc(clamp(10px, 1.4vw, 27px) * var(--k, 1));\n  --radius: clamp(16px, 2.1vw, 40px);           /* panel (HIG radius-lg, scaled for distance) */\n  --radius-in: clamp(10px, 1.15vw, 22px);       /* concentric: tiles inside the panel */\n  --hair: max(1px, .09vw);\n  /* Apple spring curves (design-system/tokens.css, generated by motion.js) */\n  --ease-smooth: linear(0, 0.004 1%, 0.019 2.3%, 0.042 3.5%, 0.079 5%, 0.161 7.8%, 0.362 13.8%, 0.465 17%, 0.557 20.3%, 0.637 23.5%, 0.706 26.8%, 0.767 30.3%, 0.817 33.8%, 0.86 37.5%, 0.899 42%, 0.929 46.8%, 0.953 52.3%, 0.971 58.5%, 0.983 65.5%, 0.991 73.8%, 1);\n  --ease-snappy: linear(0, 0.006 1.3%, 0.025 2.8%, 0.056 4.3%, 0.095 5.8%, 0.19 8.8%, 0.41 15%, 0.519 18.3%, 0.616 21.5%, 0.695 24.5%, 0.762 27.5%, 0.822 30.8%, 0.871 34%, 0.912 37.5%, 0.944 41.3%, 0.97 45.5%, 0.988 50.2%, 0.999 55.8%, 1.006 68%, 1);\n  --ease-bouncy: linear(0, 0.008 1.3%, 0.029 2.5%, 0.062 3.8%, 0.112 5.3%, 0.215 7.8%, 0.482 13.5%, 0.592 16%, 0.7 18.8%, 0.785 21.3%, 0.856 23.8%, 0.919 26.5%, 0.966 29.3%, 1.003 32.3%, 1.023 34.8%, 1.036 37.3%, 1.044 40%, 1.046 43%, 1.04 48.3%, 1.012 62.7%, 1.003 70.5%, 0.998 82.3%, 1);\n  --dur-smooth: 734ms; --dur-snappy: 557ms; --dur-bouncy: 818ms; --dur-fade: 180ms; --ease-out: cubic-bezier(.22, 1, .36, 1);\n  /* light (HIG semantic colours; secondary label raised to #6E6E73 for WCAG AA, as in the design system) */\n  --surface: #ffffff; --surface-2: #f2f2f7; --label: #000000; --label-2: #6e6e73; --label-3: rgba(60, 60, 67, .36);\n  --sep: rgba(60, 60, 67, .18); --fill: rgba(118, 118, 128, .12); --fill-2: rgba(120, 120, 128, .2);\n  --accent: #0071e3; --accent-text: #0066cc; --accent-tint: rgba(0, 113, 227, .12); --on-accent: #ffffff;\n  --ok: #34c759; --ok-text: #1d7a35; --warn: #ff8d28; --warn-text: #b25000; --bad-text: #d70015;\n  --held: rgba(0, 113, 227, .42);\n  --edge: 0 0 0 var(--hair) rgba(0, 0, 0, .05), 0 1px 2px rgba(0, 0, 0, .04), 0 1.2vw 3vw -1.6vw rgba(16, 24, 40, .18);\n  color-scheme: light;\n}\n@media (prefers-color-scheme: dark) { :root:not([data-theme=\"light\"]) {\n  --surface: #1c1c1e; --surface-2: #2c2c2e; --label: #ffffff; --label-2: rgba(235, 235, 245, .66); --label-3: rgba(235, 235, 245, .34);\n  --sep: rgba(84, 84, 88, .6); --fill: rgba(118, 118, 128, .24); --fill-2: rgba(120, 120, 128, .36);\n  --accent: #0a6fe0; --accent-text: #3d9bff; --accent-tint: rgba(61, 155, 255, .16);\n  --ok: #30d158; --ok-text: #30d158; --warn: #ff9230; --warn-text: #ff9f0a; --bad-text: #ff6961; --held: rgba(61, 155, 255, .45);\n  --edge: 0 0 0 var(--hair) rgba(255, 255, 255, .06); color-scheme: dark; } }\n:root[data-theme=\"dark\"] {\n  --surface: #1c1c1e; --surface-2: #2c2c2e; --label: #ffffff; --label-2: rgba(235, 235, 245, .66); --label-3: rgba(235, 235, 245, .34);\n  --sep: rgba(84, 84, 88, .6); --fill: rgba(118, 118, 128, .24); --fill-2: rgba(120, 120, 128, .36);\n  --accent: #0a6fe0; --accent-text: #3d9bff; --accent-tint: rgba(61, 155, 255, .16);\n  --ok: #30d158; --ok-text: #30d158; --warn: #ff9230; --warn-text: #ff9f0a; --bad-text: #ff6961; --held: rgba(61, 155, 255, .45);\n  --edge: 0 0 0 var(--hair) rgba(255, 255, 255, .06); color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; color: var(--label); font: 400 var(--t-body)/1.3 var(--font); letter-spacing: -.012em;\n  -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; font-synthesis-weight: none; -webkit-tap-highlight-color: transparent; }\n.card { position: relative; background: var(--surface); border-radius: var(--radius); padding: var(--pad); display: grid; gap: var(--gap); box-shadow: var(--edge); overflow: hidden;\n  animation: card-in var(--dur-smooth) var(--ease-smooth) both; }\n@keyframes card-in { from { opacity: 0; transform: translateY(.9vw) scale(.985); } }\n:root[data-display=\"fullscreen\"] .card { align-content: start; }\n\n/* ---------- type: hierarchy by size and weight only ---------- */\n.context { margin: 0; font-size: var(--t-meta); color: var(--label-2); font-weight: 510; letter-spacing: -.004em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }\nh1 { margin: 0; font-size: var(--t-title); line-height: 1.1; font-weight: 700; letter-spacing: -.024em; text-wrap: balance; }\n.lead { margin: 0; color: var(--label-2); font-size: var(--t-body); text-wrap: pretty; }\n.num { font-size: var(--t-num); font-weight: 700; letter-spacing: -.035em; line-height: .95; font-variant-numeric: tabular-nums; white-space: nowrap; }\n.num small { font-size: .38em; font-weight: 590; letter-spacing: -.01em; color: var(--label-2); margin-left: .25em; }\n.meta { font-size: var(--t-meta); color: var(--label-2); }\n.note { margin: 0; font-size: var(--t-meta); color: var(--label-2); text-wrap: pretty; }\n.tab { font-variant-numeric: tabular-nums; }\n\n/* ---------- layout ---------- */\n.head { display: flex; justify-content: space-between; align-items: center; gap: 1em; min-width: 0; }\n.hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 1em; min-width: 0; }\n.hero > :first-child { min-width: 0; }\n.stack { display: grid; gap: calc(var(--gap) * .45); }\n\n/* ---------- status: dot + words, never a filled pill ---------- */\n.status { display: inline-flex; align-items: center; gap: .5em; flex: none; font-size: var(--t-meta); font-weight: 590; color: var(--label); white-space: nowrap; }\n.status::before { content: \"\"; width: .55em; height: .55em; border-radius: 50%; background: var(--_c, var(--label-3)); flex: none; }\n.status.ok { --_c: var(--ok); } .status.wait { --_c: var(--warn); } .status.info { --_c: var(--accent-text); } .status.bad { --_c: var(--bad-text); color: var(--bad-text); }\n\n/* ---------- line items (grouped list, hairlines inset to the text) ---------- */\n.rows { list-style: none; margin: 0; padding: 0; display: grid; }\n.rows > li { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; column-gap: .75em; padding: .5em 0; }\n.rows > li + li::before { content: \"\"; position: absolute; top: 0; left: calc(1.25em + .75em); right: 0; border-top: var(--hair) solid var(--sep); }\n.rows.compact > li { padding: .3em 0; }\n.rows.compact .who > span { display: none; }\n.ico { width: 1.25em; height: 1.25em; display: grid; place-items: center; color: var(--label-2); flex: none; }\n.ico svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }\n.who { min-width: 0; display: grid; gap: .08em; }\n.who b { font-weight: 590; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.who > span { font-size: var(--t-meta); color: var(--label-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.amt { font-weight: 590; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }\n.amt s { color: var(--label-2); font-weight: 400; font-size: var(--t-meta); margin-right: .45em; text-decoration-thickness: .08em; }\n\n/* ---------- price breakdown (Alexa+ §8: base, fees, taxes, total) ---------- */\n.breakdown { display: flex; flex-wrap: wrap; gap: .3em 1.15em; font-size: var(--t-meta); color: var(--label-2); font-variant-numeric: tabular-nums; margin: 0; }\n.breakdown b { color: var(--label); font-weight: 590; }\n.breakdown .saved { color: var(--ok-text); }\n\n/* ---------- budget gauge ---------- */\n.gauge { display: grid; gap: .5em; min-width: 0; }\n.bar { position: relative; height: clamp(6px, .62vw, 12px); border-radius: 999px; background: var(--fill); overflow: hidden; display: flex; }\n.bar span { height: 100%; flex: none; transition: width 1s var(--ease-smooth); }\n.bar .spent { background: var(--accent); }\n.bar .held { background: var(--held); }\n.bar .next { background: repeating-linear-gradient(135deg, var(--held) 0 .32vw, transparent .32vw .6vw); box-shadow: inset 0 0 0 var(--hair) var(--held); border-radius: 0 999px 999px 0; }\n.gauge-text { font-size: var(--t-meta); color: var(--label-2); display: flex; justify-content: space-between; gap: 1em; font-variant-numeric: tabular-nums; }\n.gauge-text b { color: var(--label); font-weight: 590; }\n\n/* ---------- actions (one prominent action per card) ---------- */\n.actions { display: flex; gap: .6em; align-items: center; flex-wrap: wrap; }\nbutton { font: inherit; color: inherit; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }\n.btn { appearance: none; border: 0; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; gap: .5em;\n  font-size: var(--t-body); font-weight: 590; letter-spacing: -.012em; min-height: max(48px, 2.3em); padding: 0 1.15em; cursor: pointer; white-space: nowrap;\n  background: var(--fill); color: var(--label);\n  transition: transform var(--dur-bouncy) var(--ease-bouncy), background-color var(--dur-fade) var(--ease-out), opacity var(--dur-fade) var(--ease-out); }\n.btn:active { transform: scale(.96); transition-duration: 250ms, var(--dur-fade), var(--dur-fade); transition-timing-function: var(--ease-smooth); }\n.btn.primary { background: var(--accent); color: var(--on-accent); padding: 0 1.3em; }\n.btn.primary:active { background: color-mix(in srgb, var(--accent) 86%, #000); }\n.btn[disabled] { cursor: default; }\n.btn[aria-busy=\"true\"] { opacity: .78; }\n.btn:focus-visible { outline: max(3px, .25vw) solid color-mix(in srgb, #0088ff 70%, transparent); outline-offset: max(2px, .15vw); }\n.spin { width: 1em; height: 1em; border-radius: 50%; border: .14em solid currentColor; border-right-color: transparent; animation: spin .8s linear infinite; flex: none; }\n@keyframes spin { to { transform: rotate(1turn); } }\n.done { display: inline-flex; align-items: center; gap: .5em; font-weight: 590; color: var(--label); min-height: max(48px, 2.3em); }\n.done .tick { width: 1.45em; height: 1.45em; border-radius: 50%; display: grid; place-items: center; background: var(--ok); color: #fff; flex: none;\n  animation: tick-in var(--dur-bouncy) var(--ease-bouncy) both; }\n.done .tick svg { width: 62%; height: 62%; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }\n@keyframes tick-in { from { transform: scale(.4); opacity: 0; } }\n.done span { font-weight: 400; color: var(--label-2); font-size: var(--t-meta); }\n\n/* ---------- loading: skeleton in the card's real shape + words ---------- */\n.sk { display: block; border-radius: .3em; background: var(--fill); position: relative; overflow: hidden; }\n.sk::after { content: \"\"; position: absolute; inset: 0; transform: translateX(-100%); background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--surface) 55%, transparent), transparent); animation: shimmer 1.5s var(--ease-out) infinite; }\n@keyframes shimmer { to { transform: translateX(100%); } }\n.sk-title { height: 1.15em; width: 46%; font-size: var(--t-title); }\n.sk-num { height: .9em; width: 3.4em; font-size: var(--t-num); }\n.sk-row { height: 1em; width: 100%; }\n.sk-row.short { width: 72%; }\n.loading .hero { align-items: center; }\n\n/* ---------- device classes from the host ---------- */\n:root[data-device=\"dot\"] .card { display: none; }\n@media (prefers-reduced-motion: reduce) {\n  .card, .done .tick { animation: none; }\n  .bar span, .btn { transition: none; }\n  .sk::after, .spin { animation: none; }\n}\n\n.foot { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: calc(var(--gap) * 1.6); align-items: center; padding-top: calc(var(--gap) * .2); }\n:root[data-display=\"fullscreen\"] #expand, :root:not([data-display=\"fullscreen\"]) #back { display: none; }\n:root:not([data-display=\"fullscreen\"]) .who span.long { display: none; }\n.who span.long { white-space: normal; }\n.also { margin: 0; display: flex; align-items: baseline; gap: .8em; font-size: var(--t-meta); color: var(--label-2); padding: .55em .8em; border-radius: var(--radius-in); background: var(--surface-2); min-width: 0; }\n.also span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.also b { color: var(--label); font-weight: 590; }\n.err { flex-basis: 100%; margin: 0; font-size: var(--t-meta); color: var(--bad-text); }\n</style></head>\n<body><main class=\"card\" id=\"app\" aria-live=\"polite\"><p class=\"context\">Preparing your plan…</p></main>\n<script>// MCP Apps view bridge (spec 2026-01-26, io.modelcontextprotocol/ui), dependency-free.\n// View -> Host requests: ui/initialize, tools/call, ui/update-model-context, ui/request-display-mode, ui/open-link, ui/message\n// View -> Host notifications: ui/notifications/initialized, ui/notifications/size-changed\n// Host -> View: ui/notifications/tool-input, tool-input-partial, tool-result, tool-cancelled, host-context-changed,\n//               ui/resource-teardown (request: answered with {})\n(function () {\n  const pending = new Map();\n  const handlers = {};\n  let nextId = 1;\n  let hostContext = {};\n  const post = (msg) => window.parent.postMessage(msg, '*');\n  function request(method, params) {\n    const id = nextId++;\n    post({ jsonrpc: '2.0', id, method, params: params || {} });\n    return new Promise((resolve, reject) => {\n      pending.set(id, { resolve, reject });\n      setTimeout(() => { if (pending.delete(id)) reject(new Error(method + ' timed out')); }, 30000);\n    });\n  }\n  const notify = (method, params) => post({ jsonrpc: '2.0', method, params: params || {} });\n\n  window.addEventListener('message', (e) => {\n    if (e.source !== window.parent) return; // only the host that embeds us\n    const m = e.data;\n    if (!m || m.jsonrpc !== '2.0') return;\n    if (m.id !== undefined && !m.method) {\n      const p = pending.get(m.id);\n      if (!p) return;\n      pending.delete(m.id);\n      return m.error ? p.reject(Object.assign(new Error(m.error.message), { code: m.error.code })) : p.resolve(m.result);\n    }\n    if (m.method === 'ui/resource-teardown') { (handlers.teardown || (() => {}))(m.params); return post({ jsonrpc: '2.0', id: m.id, result: {} }); }\n    if (m.method === 'ui/notifications/host-context-changed') { hostContext = { ...hostContext, ...m.params }; applyContext(); (handlers.context || (() => {}))(hostContext); autoFit(); return; }\n    const short = { 'ui/notifications/tool-input': 'input', 'ui/notifications/tool-input-partial': 'partial', 'ui/notifications/tool-result': 'result', 'ui/notifications/tool-cancelled': 'cancelled' }[m.method];\n    if (short && handlers[short]) { handlers[short](m.params); if (short === 'result') autoFit(); }\n    else if (m.id !== undefined) post({ jsonrpc: '2.0', id: m.id, error: { code: -32601, message: 'Method not found' } });\n  });\n\n  function applyContext() {\n    const root = document.documentElement;\n    if (hostContext.theme) root.dataset.theme = hostContext.theme;\n    const vars = hostContext.styles && hostContext.styles.variables;\n    if (vars) for (const [k, v] of Object.entries(vars)) if (v) root.style.setProperty(k, v);\n    const dm = hostContext.displayMode || 'inline';\n    root.dataset.display = dm;\n    const p = hostContext.platform || '';\n    root.dataset.device = (hostContext.deviceCapabilities && hostContext.deviceCapabilities.deviceClass) || (p === 'mobile' ? 'phone' : 'show');\n  }\n\n  // Glanceable means no scrolling: when the host gives a maxHeight (hostContext.containerDimensions) and the card is\n  // taller, the whole type scale shrinks a little (--k), down to 72%, in inline and fullscreen alike.\n  function autoFit() {\n    const root = document.documentElement;\n    const max = hostContext.containerDimensions && hostContext.containerDimensions.maxHeight;\n    root.style.setProperty('--k', '1');\n    if (!max) return;\n    // measure the card itself: the iframe viewport may still be taller than the content\n    const h = () => { const c = document.querySelector('main'); return c ? c.getBoundingClientRect().height : root.scrollHeight; };\n    let k = 1;\n    while (h() > max + 1 && k > 0.73) { k = Math.round((k - 0.03) * 100) / 100; root.style.setProperty('--k', String(k)); }\n  }\n  window.mcpAutoFit = autoFit;\n\n  // Tell the host our size whenever it changes (inline cards grow with their content).\n  let last = '';\n  const ro = new ResizeObserver(() => {\n    const r = document.documentElement.getBoundingClientRect();\n    const key = Math.ceil(r.width) + 'x' + Math.ceil(r.height);\n    if (key !== last) { last = key; notify('ui/notifications/size-changed', { width: Math.ceil(r.width), height: Math.ceil(document.body.scrollHeight) }); }\n  });\n\n  window.mcpApp = {\n    on(event, fn) { handlers[event] = fn; },\n    get hostContext() { return hostContext; },\n    async connect(name) {\n      try {\n        const r = await request('ui/initialize', {\n          protocolVersion: '2026-01-26',\n          clientInfo: { name, version: '1.0.0' },\n          appCapabilities: { availableDisplayModes: ['inline', 'fullscreen'] },\n        });\n        hostContext = (r && r.hostContext) || {};\n      } catch (e) { hostContext = {}; }\n      applyContext();\n      notify('ui/notifications/initialized', {});\n      ro.observe(document.body);\n      return hostContext;\n    },\n    callTool(name, args) { return request('tools/call', { name, arguments: args || {} }); },\n    updateModelContext(content, structuredContent) { return request('ui/update-model-context', { content, structuredContent }); },\n    requestDisplayMode(mode) { return request('ui/request-display-mode', { mode }); },\n    openLink(url) { return request('ui/open-link', { url }); },\n    say(text) { return request('ui/message', { role: 'user', content: [{ type: 'text', text }] }); },\n  };\n})();\n\n// Small shared helpers for the cards.\nconst $ = (sel, el = document) => el.querySelector(sel);\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\nconst usd = (n, cur = 'USD') => new Intl.NumberFormat('en-US', { style: 'currency', currency: cur, minimumFractionDigits: Number.isInteger(Math.round(n * 100) / 100) ? 0 : 2 }).format(n || 0);\nconst cap = (s) => String(s || '').charAt(0).toUpperCase() + String(s || '').slice(1);\nconst ICONS = {\n  cleaning: '<path d=\"M14 3 9 13M7 13h6l3 8H4l3-8Z\"/><path d=\"M18 4v3M16.5 5.5h3\"/>',\n  catering: '<path d=\"M4 16h16M5 16a7 7 0 0 1 14 0M12 7V5.5M10.5 5.5h3M3 19h18\"/>',\n  plumbing: '<path d=\"M4 10h8a3 3 0 0 1 3 3v2h3v-5h2v9h-2v-2h-5v-2a1 1 0 0 0-1-1H4Z\"/><path d=\"M8 10V6M6 6h4\"/>',\n  handyman: '<path d=\"M14.5 6.5a4 4 0 0 0 4.9 4.9L21 13l-8 8-3-3 8-8-1.6-1.6a4 4 0 0 0-4.9-4.9l2.5 2.5-1.4 1.4Z\"/><path d=\"M3 21l6-6\"/>',\n  product: '<path d=\"M4 8 12 4l8 4v8l-8 4-8-4Z\"/><path d=\"M4 8l8 4 8-4M12 12v8\"/>',\n  memory: '<path d=\"M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z\"/>',\n  check: '<path d=\"M5 12.5 10 17 19 7\"/>',\n};\nconst icon = (k) => `<span class=\"ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\">${ICONS[k] || ICONS.product}</svg></span>`;\nconst kindIcon = (o) => icon(o.kind === 'product' ? 'product' : o.category || guessCategory(o));\nconst status = (tone, text) => `<span class=\"status ${tone}\">${esc(text)}</span>`;\nfunction guessCategory(o) {\n  const t = `${o.merchant || ''} ${o.title || o.label || ''}`.toLowerCase();\n  if (/clean|maid|tidy|nest/.test(t)) return 'cleaning';\n  if (/cater|dinner|kitchen|table|chef|olive/.test(t)) return 'catering';\n  if (/plumb|leak|pipe/.test(t)) return 'plumbing';\n  if (/handy|fix|mount/.test(t)) return 'handyman';\n  return 'product';\n}\n// Budget gauge: spent, held, and (optional) what this plan would add. `grow` starts the new segment at zero so it\n// springs to its real width once painted (a state change made visible, not decoration).\nfunction gauge(env, { adding = 0, after = null, grow = false } = {}) {\n  if (!env || !env.budget) return '';\n  const pct = (x) => Math.max(0, Math.min(100, (x / env.budget) * 100));\n  const left = after ?? env.remaining;\n  const per = env.period && env.period !== 'once' ? ' this ' + esc({ weekly: 'week', monthly: 'month' }[env.period] || env.period) : '';\n  return `<div class=\"gauge\" role=\"img\" aria-label=\"${esc(usd(left))} left of ${esc(usd(env.budget))}${after !== null ? ' after this' : ''}\">\n    <div class=\"bar\"><span class=\"spent\" style=\"width:${pct(env.spent)}%\"></span><span class=\"held\" style=\"width:${pct(env.held)}%\"></span>${adding ? `<span class=\"next\" data-w=\"${pct(adding)}\" style=\"width:${grow ? 0 : pct(adding)}%\"></span>` : ''}</div>\n    <div class=\"gauge-text\"><span><b>${usd(left)}</b> left${after !== null ? ' after this' : ''}</span><span>${esc(env.purpose || '')} · ${usd(env.budget)}${per}</span></div>\n  </div>`;\n}\nfunction growGauges() {\n  requestAnimationFrame(() => requestAnimationFrame(() => { for (const s of document.querySelectorAll('.bar .next[data-w]')) s.style.width = s.dataset.w + '%'; }));\n}\n// Loading: the card's real shape, plus words that say what is happening.\nfunction skeleton(words) {\n  return `<div class=\"head\"><p class=\"context\">${esc(words)}</p></div>\n    <div class=\"hero\"><span class=\"sk sk-title\"></span><span class=\"sk sk-num\"></span></div>\n    <div class=\"stack\"><span class=\"sk sk-row\"></span><span class=\"sk sk-row short\"></span><span class=\"sk sk-row\"></span></div>`;\n}\nfunction showLoading(words) { const a = document.querySelector('main.card'); if (a) { a.classList.add('loading'); a.setAttribute('aria-busy', 'true'); a.innerHTML = skeleton(words); } }\n// Error: the cause as the title, then the one next step the server gave (Alexa+ guide: errors offer one action).\nfunction showError(result) {\n  const text = (result.content || []).map((c) => c.text).join(' ');\n  const [cause, next] = text.split(/\\s*Next step:\\s*/);\n  const a = document.querySelector('main.card');\n  a.classList.remove('loading'); a.removeAttribute('aria-busy');\n  a.innerHTML = `<div class=\"head\"><p class=\"context\">Mandat needs a change</p>${status('wait', 'Not done')}</div>\n    <h1>${esc(cause)}</h1>${next ? `<p class=\"lead\">${esc(next)}</p>` : ''}`;\n}\nfunction ready() { const a = document.querySelector('main.card'); if (a) { a.classList.remove('loading'); a.removeAttribute('aria-busy'); } }\n\nshowLoading('Preparing your plan…');\nlet current = null;\nconst TICK = `<span class=\"tick\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\">${ICONS.check}</svg></span>`;\nfunction render(result, { justBooked = false } = {}) {\n  if (result.isError) return showError(result);\n  const sc = result.structuredContent || {};\n  const plan = sc.plan; if (!plan) return;\n  ready();\n  current = sc;\n  const b = plan.breakdown;\n  const n = plan.lines.length;\n  const booked = plan.status === 'confirmed';\n  const st = booked ? status('ok', 'Booked') : plan.auto_approved ? status('ok', 'Within your rule') : status('wait', 'Needs your yes');\n  const env = sc.envelope;\n  $('#app').innerHTML = `\n    <div class=\"head\"><p class=\"context\">${esc(plan.purpose || 'Plan')} · ${booked ? 'payment holds placed' : n === 1 ? 'one item' : `${n} items in one plan`}</p>${st}</div>\n    <div class=\"hero\">\n      <h1>${booked ? (n === 1 ? 'Booked' : `${n} bookings, one approval`) : n === 1 ? esc(cap(plan.lines[0].title || plan.lines[0].merchant)) : `${n} items, one yes`}</h1>\n      <span class=\"num\">${usd(b.total)}</span>\n    </div>\n    <ul class=\"rows\">${plan.lines.map((l) => `<li>${kindIcon(l)}<span class=\"who\"><b>${esc(l.merchant)}</b><span>${l.kind === 'product' ? (n === 1 ? esc(l.detail || '') : `${esc(l.title)} · ${esc(l.detail || '')}`) : `${esc(l.detail || '')}${l.guests ? ` · ${l.guests} guests` : ''}`}</span>${l.kind === 'product' ? '' : `<span class=\"long\">${esc(l.title)}</span>`}</span><span class=\"amt\">${l.discount ? `<s>${usd(l.base + (l.fees || 0))}</s>` : ''}${usd(l.total)}</span></li>`).join('')}</ul>\n    ${(sc.also_bought || []).length && !booked ? `<p class=\"also\">${status('ok', 'Already bought')}<span>${sc.also_bought.map((o) => `${esc(o.merchant)}, ${esc(o.label || '')} <b>${usd(o.amount)}</b>`).join(' · ')}, within your ${env && env.auto_approve_under ? usd(env.auto_approve_under) + ' ' : ''}rule</span></p>` : ''}\n    <p class=\"breakdown\"><span>Base <b>${usd(b.base)}</b></span>${b.discount ? `<span>Negotiated <b class=\"saved\">−${usd(b.discount)}</b></span>` : ''}<span>Fees <b>${usd(b.fees)}</b></span><span>Tax <b>${usd(b.tax)}</b></span><span>Total <b>${usd(b.total)}</b></span></p>\n    <div class=\"foot\">\n      <div class=\"actions\" id=\"actions\">${booked ? `<span class=\"done\">${TICK}Booked<span>Nothing is charged until it is done</span></span>` :\n        `<button class=\"btn primary\" id=\"approve\">${plan.auto_approved ? 'Buy now' : 'Approve ' + usd(b.total)}</button><button class=\"btn\" id=\"expand\">Details</button><button class=\"btn\" id=\"back\">Back</button>`}</div>\n      ${env ? gauge(env, booked ? {} : { adding: b.total, after: plan.remaining_after ?? null, grow: !current.__shown }) : ''}\n    </div>`;\n  if (!booked) { growGauges(); current.__shown = true; }\n  const a = $('#approve');\n  if (a) a.onclick = async () => {\n    if (a.disabled) return;\n    a.disabled = true; a.setAttribute('aria-busy', 'true'); a.innerHTML = '<span class=\"spin\" aria-hidden=\"true\"></span>Placing holds…';\n    $('#actions .err')?.remove();\n    const fail = (msg) => { a.disabled = false; a.removeAttribute('aria-busy'); a.textContent = 'Try again'; if (msg) $('#actions').insertAdjacentHTML('beforeend', `<p class=\"err\">${esc(msg)}</p>`); };\n    try {\n      const r = await mcpApp.callTool('confirm_plan', { plan_id: plan.id, confirmation_token: current.confirmation_token, user_confirmation: 'tap:approve' });\n      if (r.isError) return fail((r.content || []).map((c) => c.text).join(' ').replace(/\\s*Next step:.*$/, ''));\n      plan.status = 'confirmed';\n      const env2 = r.structuredContent && r.structuredContent.receipt && r.structuredContent.receipt.envelope;\n      render({ structuredContent: { ...current, plan, envelope: env2 || current.envelope } }, { justBooked: true });\n    } catch (e) { fail('Mandat could not be reached. Nothing was booked.'); }\n  };\n  const x = $('#expand'); if (x) x.onclick = () => mcpApp.requestDisplayMode('fullscreen').catch(() => {});\n  const bk = $('#back'); if (bk) bk.onclick = () => mcpApp.requestDisplayMode('inline').catch(() => {});\n}\nmcpApp.on('result', render);\nmcpApp.connect('mandat-plan');\n</script></body></html>\n"}]}}
