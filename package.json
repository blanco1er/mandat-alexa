{
  "name": "mandat-alexa",
  "version": "0.1.0",
  "description": "Mandat for Alexa+: an MCP server that lets Alexa+ act on a budget you set once: it finds real merchants, negotiates with their AI agents, asks before paying and pays with PayPal (sandbox).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "demo": "MANDAT_MODEL=simulated MANDAT_PAYPAL=offline node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:orchestrator": "cd orchestrator && npm test",
    "package": "sh scripts/package-lambda.sh",
    "inspect": "bash scripts/inspector-check.sh",
    "deploy:aws": "bash scripts/deploy-aws.sh",
    "live:scenarios": "node scripts/live-scenarios.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-polly": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0"
  }
}
