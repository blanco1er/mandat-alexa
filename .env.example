# Names only. Copy to .env (git-ignored) and fill locally, or set them on the Lambda function.
# Never commit real values.

# --- runtime switches ---
PORT=8787
MANDAT_STORE=json                # memory | json | dynamodb
MANDAT_MODEL=simulated           # simulated | bedrock   (merchant agents)
MANDAT_BRAIN=simulated           # simulated | strands   (the Alexa+ brain behind /turn)
MANDAT_BRAIN_MODEL=scripted      # scripted | bedrock    (when MANDAT_BRAIN=strands)
MANDAT_TTS=browser               # browser | polly
MANDAT_PAYPAL=                   # "offline" forces simulated payments even when keys exist
MANDAT_SHOP=off                  # live = Channel3 product search (needs CHANNEL3_API_KEY)

# --- URLs and protection ---
MANDAT_PUBLIC_URL=
MANDAT_ALLOWED_ORIGINS=
MANDAT_DEMO_TOKEN=
MANDAT_NETWORK_SECRET=
MANDAT_LLM_BUDGET_USD=

# --- AWS (Lambda provides credentials through its role; nothing to put here) ---
AWS_REGION=us-east-1
MANDAT_TABLE=mandat
MANDAT_BEDROCK_BRAIN_ID=us.amazon.nova-2-lite-v1:0        # the Alexa+ brain (Strands); Claude ids work where enabled
MANDAT_BRAIN_FALLBACK_ID=global.amazon.nova-2-lite-v1:0   # used when the US profile is throttled (20 requests/min)
MANDAT_BRAIN_REASONING=                                   # low | medium: Nova 2 extended reasoning (off by default)
MANDAT_MERCHANT_MODEL=us.amazon.nova-lite-v1:0            # merchant agents (200 requests/min pool)
MANDAT_MERCHANT_FALLBACK_ID=global.amazon.nova-2-lite-v1:0
MANDAT_POLLY_VOICE=Danielle

# --- public demo limits (per IP, per hour, per warm process; 0 = off) ---
MANDAT_LIMIT_TURNS=60
MANDAT_LIMIT_TTS=120
MANDAT_LIMIT_MCP=600

# --- secrets (sandbox only) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CHANNEL3_API_KEY=
