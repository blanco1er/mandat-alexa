{"result":{"contents":[{"uri":"ui://mandat/plan-a082436ce8.html","mimeType":"text/html;profile=mcp-app","_meta":{"ui":{"csp":{"connectDomains":[],"resourceDomains":[]},"prefersBorder":false}},"text":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Mandat plan</title>\n<style>/* Mandat cards (MCP Apps views). Alexa+ add-on design guide: glanceable at a distance (one title, one or two\n   supporting fields, one clear action), text sized for the room, voice and screen say the same thing.\n   Type scales with the card's own width (vw = the iframe), so a card looks the same on Echo Show 8 and 15.\n   Theme comes from the host (hostContext.theme); without a host it follows the system. Fully inline: no fonts,\n   images or scripts from anywhere else (empty CSP lists). */\n:root {\n  --font: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro Text\", \"Segoe UI Variable Display\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  /* --k: set by the bridge when the host's containerDimensions.maxHeight is smaller than the card (auto-fit) */\n  --t-eyebrow: calc(clamp(11px, 1.5vw, 30px) * var(--k, 1)); --t-small: calc(clamp(12px, 1.65vw, 32px) * var(--k, 1)); --t-body: calc(clamp(14px, 2.05vw, 40px) * var(--k, 1));\n  --t-title: calc(clamp(19px, 3.05vw, 60px) * var(--k, 1)); --t-num: calc(clamp(26px, 4.7vw, 92px) * var(--k, 1));\n  --pad: calc(clamp(16px, 2.6vw, 52px) * var(--k, 1)); --gap: calc(clamp(9px, 1.35vw, 28px) * var(--k, 1)); --radius: clamp(18px, 2.5vw, 48px);\n  --ease: cubic-bezier(.2, .7, .2, 1);\n  /* light */\n  --surface: #ffffff; --surface-2: #f4f6f9; --ink: #0d1015; --muted: #5e6571; --faint: #969ca7; --line: rgba(13, 16, 21, .09);\n  --accent: #0a8fd6; --accent-soft: rgba(10, 143, 214, .12); --good: #12936a; --good-soft: rgba(18, 147, 106, .12); --warn: #b26b00; --warn-soft: rgba(178, 107, 0, .12);\n  --btn: #0d1015; --btn-ink: #ffffff; --held: rgba(10, 143, 214, .38); --spent: #0a8fd6;\n  --edge: 0 1px 0 rgba(255, 255, 255, .9) inset, 0 1px 2px rgba(13, 16, 21, .06), 0 18px 40px -22px rgba(13, 16, 21, .25);\n  color-scheme: light;\n}\n@media (prefers-color-scheme: dark) { :root:not([data-theme=\"light\"]) {\n  --surface: #12151a; --surface-2: #1a1e25; --ink: #f4f7fb; --muted: #a1a9b5; --faint: #6c7480; --line: rgba(255, 255, 255, .08);\n  --accent: #4fd2ff; --accent-soft: rgba(79, 210, 255, .13); --good: #45dba0; --good-soft: rgba(69, 219, 160, .13); --warn: #ffb547; --warn-soft: rgba(255, 181, 71, .13);\n  --btn: #f4f7fb; --btn-ink: #0b0d11; --held: rgba(79, 210, 255, .4); --spent: #4fd2ff;\n  --edge: 0 1px 0 rgba(255, 255, 255, .06) inset, 0 0 0 1px rgba(255, 255, 255, .06), 0 24px 50px -24px rgba(0, 0, 0, .8); color-scheme: dark; } }\n:root[data-theme=\"dark\"] {\n  --surface: #12151a; --surface-2: #1a1e25; --ink: #f4f7fb; --muted: #a1a9b5; --faint: #6c7480; --line: rgba(255, 255, 255, .08);\n  --accent: #4fd2ff; --accent-soft: rgba(79, 210, 255, .13); --good: #45dba0; --good-soft: rgba(69, 219, 160, .13); --warn: #ffb547; --warn-soft: rgba(255, 181, 71, .13);\n  --btn: #f4f7fb; --btn-ink: #0b0d11; --held: rgba(79, 210, 255, .4); --spent: #4fd2ff;\n  --edge: 0 1px 0 rgba(255, 255, 255, .06) inset, 0 0 0 1px rgba(255, 255, 255, .06), 0 24px 50px -24px rgba(0, 0, 0, .8); color-scheme: dark;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; color: var(--ink); font: 400 var(--t-body)/1.32 var(--font); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }\n.card { position: relative; background: var(--surface); border-radius: var(--radius); padding: var(--pad); display: grid; gap: var(--gap); box-shadow: var(--edge); overflow: hidden; animation: rise .5s var(--ease) both; }\n.card::before { content: \"\"; position: absolute; inset: 0 0 auto; height: 40%; pointer-events: none; background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 5%, transparent), transparent); }\n.card > * { position: relative; }\n@keyframes rise { from { opacity: 0; transform: translateY(6px); } }\n:root[data-display=\"fullscreen\"] .card { min-height: 100vh; border-radius: 0; align-content: start; }\n\n/* type */\n.eyebrow { margin: 0; font-size: var(--t-eyebrow); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); font-weight: 650; display: flex; align-items: center; gap: .6em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.eyebrow .sep { width: .3em; height: .3em; border-radius: 50%; background: var(--faint); flex: none; }\nh1 { margin: 0; font-size: var(--t-title); line-height: 1.08; font-weight: 650; letter-spacing: -.022em; text-wrap: balance; }\n.lead { margin: 0; color: var(--muted); font-size: var(--t-body); text-wrap: pretty; }\n.num { font-size: var(--t-num); font-weight: 700; letter-spacing: -.035em; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }\n.small { font-size: var(--t-small); color: var(--muted); }\n.muted { color: var(--muted); }\n.good { color: var(--good); }\n.tab { font-variant-numeric: tabular-nums; }\n\n/* layout */\n.head { display: flex; justify-content: space-between; align-items: center; gap: 1em; min-width: 0; }\n.hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 1em; }\n.hero h1 { min-width: 0; }\n.stack { display: grid; gap: calc(var(--gap) * .5); }\n\n/* status pill */\n.pill { display: inline-flex; align-items: center; gap: .5em; flex: none; font-size: var(--t-eyebrow); font-weight: 650; letter-spacing: .02em; padding: .45em 1em; border-radius: 999px; background: var(--accent-soft); color: var(--accent); white-space: nowrap; }\n.pill::before { content: \"\"; width: .55em; height: .55em; border-radius: 50%; background: currentColor; }\n.pill.ok { background: var(--good-soft); color: var(--good); }\n.pill.wait { background: var(--warn-soft); color: var(--warn); }\n.pill.wait::before { animation: blink 1.6s ease-in-out infinite; }\n@keyframes blink { 50% { opacity: .3; } }\n\n/* line items */\n.rows { list-style: none; margin: 0; padding: 0; display: grid; }\n.rows li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .8em; padding: .45em 0; border-top: 1px solid var(--line); }\n.rows.compact li { padding: .32em 0; } .rows.compact .who span { display: none; } .rows.compact .ico { width: 1.55em; height: 1.55em; }\n.rows li:first-child { border-top: 0; padding-top: .1em; }\n.ico { width: 1.9em; height: 1.9em; border-radius: 30%; display: grid; place-items: center; background: var(--surface-2); color: var(--muted); flex: none; }\n.ico svg { width: 58%; height: 58%; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }\n.who { min-width: 0; display: grid; }\n.who b { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.who span { font-size: var(--t-small); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.amt { font-weight: 650; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }\n.amt s { color: var(--faint); font-weight: 450; font-size: var(--t-small); margin-right: .5em; }\n\n/* price breakdown (Alexa+ §8: base, fees, taxes, total) */\n.breakdown { display: flex; flex-wrap: wrap; gap: .35em 1.2em; font-size: var(--t-small); color: var(--muted); font-variant-numeric: tabular-nums; }\n.breakdown b { color: var(--ink); font-weight: 600; }\n\n/* budget gauge */\n.gauge { display: grid; gap: .45em; }\n.bar { height: clamp(6px, .9vw, 16px); border-radius: 999px; background: var(--surface-2); overflow: hidden; display: flex; box-shadow: 0 0 0 1px var(--line) inset; }\n.bar span { height: 100%; transition: width .9s var(--ease); }\n.bar .spent { background: var(--spent); } .bar .held { background: var(--held); } .bar .next { background: repeating-linear-gradient(135deg, var(--held) 0 6px, transparent 6px 11px); }\n.gauge-text { font-size: var(--t-small); color: var(--muted); display: flex; justify-content: space-between; gap: 1em; font-variant-numeric: tabular-nums; }\n.gauge-text b { color: var(--ink); font-weight: 650; }\n\n/* actions */\n.actions { display: flex; gap: .7em; align-items: center; flex-wrap: wrap; }\nbutton { font: inherit; color: inherit; }\nbutton.primary { appearance: none; border: 0; border-radius: 999px; background: var(--btn); color: var(--btn-ink); font-weight: 650; font-size: var(--t-body); padding: .72em 1.5em; min-height: 48px; cursor: pointer; letter-spacing: -.01em; transition: transform .15s var(--ease), opacity .2s; }\nbutton.primary:active { transform: scale(.98); }\nbutton.primary[disabled] { opacity: .55; cursor: default; }\nbutton.ghost { appearance: none; border: 1px solid var(--line); background: transparent; border-radius: 999px; font-weight: 600; font-size: var(--t-small); padding: .7em 1.2em; min-height: 44px; cursor: pointer; color: var(--ink); }\n.note { margin: 0; font-size: var(--t-small); color: var(--muted); }\n.done { display: inline-flex; align-items: center; gap: .55em; font-weight: 650; color: var(--good); }\n.done svg { width: 1.15em; height: 1.15em; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }\n\n/* device classes from the host */\n:root[data-device=\"dot\"] .card { display: none; }\n\n.saved { font-size: var(--t-small); font-weight: 600; color: var(--good); }\n.foot { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: calc(var(--gap) * 1.4); align-items: center; }\n:root[data-display=\"fullscreen\"] #expand, :root:not([data-display=\"fullscreen\"]) #back { display: none; }\n:root:not([data-display=\"fullscreen\"]) .who span.long { display: none; }\n</style></head>\n<body><main class=\"card\" id=\"app\"><p class=\"eyebrow\">Mandat · plan</p><h1>Preparing your plan…</h1></main>\n<script>// MCP Apps view bridge (spec 2026-01-26, io.modelcontextprotocol/ui), dependency-free.\n// View -> Host requests: ui/initialize, tools/call, ui/update-model-context, ui/request-display-mode, ui/open-link, ui/message\n// View -> Host notifications: ui/notifications/initialized, ui/notifications/size-changed\n// Host -> View: ui/notifications/tool-input, tool-input-partial, tool-result, tool-cancelled, host-context-changed,\n//               ui/resource-teardown (request: answered with {})\n(function () {\n  const pending = new Map();\n  const handlers = {};\n  let nextId = 1;\n  let hostContext = {};\n  const post = (msg) => window.parent.postMessage(msg, '*');\n  function request(method, params) {\n    const id = nextId++;\n    post({ jsonrpc: '2.0', id, method, params: params || {} });\n    return new Promise((resolve, reject) => {\n      pending.set(id, { resolve, reject });\n      setTimeout(() => { if (pending.delete(id)) reject(new Error(method + ' timed out')); }, 30000);\n    });\n  }\n  const notify = (method, params) => post({ jsonrpc: '2.0', method, params: params || {} });\n\n  window.addEventListener('message', (e) => {\n    if (e.source !== window.parent) return; // only the host that embeds us\n    const m = e.data;\n    if (!m || m.jsonrpc !== '2.0') return;\n    if (m.id !== undefined && !m.method) {\n      const p = pending.get(m.id);\n      if (!p) return;\n      pending.delete(m.id);\n      return m.error ? p.reject(Object.assign(new Error(m.error.message), { code: m.error.code })) : p.resolve(m.result);\n    }\n    if (m.method === 'ui/resource-teardown') { (handlers.teardown || (() => {}))(m.params); return post({ jsonrpc: '2.0', id: m.id, result: {} }); }\n    if (m.method === 'ui/notifications/host-context-changed') { hostContext = { ...hostContext, ...m.params }; applyContext(); (handlers.context || (() => {}))(hostContext); autoFit(); return; }\n    const short = { 'ui/notifications/tool-input': 'input', 'ui/notifications/tool-input-partial': 'partial', 'ui/notifications/tool-result': 'result', 'ui/notifications/tool-cancelled': 'cancelled' }[m.method];\n    if (short && handlers[short]) { handlers[short](m.params); if (short === 'result') autoFit(); }\n    else if (m.id !== undefined) post({ jsonrpc: '2.0', id: m.id, error: { code: -32601, message: 'Method not found' } });\n  });\n\n  function applyContext() {\n    const root = document.documentElement;\n    if (hostContext.theme) root.dataset.theme = hostContext.theme;\n    const vars = hostContext.styles && hostContext.styles.variables;\n    if (vars) for (const [k, v] of Object.entries(vars)) if (v) root.style.setProperty(k, v);\n    const dm = hostContext.displayMode || 'inline';\n    root.dataset.display = dm;\n    const p = hostContext.platform || '';\n    root.dataset.device = (hostContext.deviceCapabilities && hostContext.deviceCapabilities.deviceClass) || (p === 'mobile' ? 'phone' : 'show');\n  }\n\n  // Glanceable means no scrolling: when the host gives a maxHeight (hostContext.containerDimensions) and the card is\n  // taller, the whole type scale shrinks a little (--k), down to 72%. Fullscreen cards are never shrunk.\n  function autoFit() {\n    const root = document.documentElement;\n    const max = hostContext.containerDimensions && hostContext.containerDimensions.maxHeight;\n    root.style.setProperty('--k', '1');\n    if (!max || hostContext.displayMode === 'fullscreen') return;\n    // measure the card itself: the iframe viewport may still be taller than the content\n    const h = () => { const c = document.querySelector('main'); return c ? c.getBoundingClientRect().height : root.scrollHeight; };\n    let k = 1;\n    while (h() > max + 1 && k > 0.73) { k = Math.round((k - 0.03) * 100) / 100; root.style.setProperty('--k', String(k)); }\n  }\n  window.mcpAutoFit = autoFit;\n\n  // Tell the host our size whenever it changes (inline cards grow with their content).\n  let last = '';\n  const ro = new ResizeObserver(() => {\n    const r = document.documentElement.getBoundingClientRect();\n    const key = Math.ceil(r.width) + 'x' + Math.ceil(r.height);\n    if (key !== last) { last = key; notify('ui/notifications/size-changed', { width: Math.ceil(r.width), height: Math.ceil(document.body.scrollHeight) }); }\n  });\n\n  window.mcpApp = {\n    on(event, fn) { handlers[event] = fn; },\n    get hostContext() { return hostContext; },\n    async connect(name) {\n      try {\n        const r = await request('ui/initialize', {\n          protocolVersion: '2026-01-26',\n          clientInfo: { name, version: '1.0.0' },\n          appCapabilities: { availableDisplayModes: ['inline', 'fullscreen'] },\n        });\n        hostContext = (r && r.hostContext) || {};\n      } catch (e) { hostContext = {}; }\n      applyContext();\n      notify('ui/notifications/initialized', {});\n      ro.observe(document.body);\n      return hostContext;\n    },\n    callTool(name, args) { return request('tools/call', { name, arguments: args || {} }); },\n    updateModelContext(content, structuredContent) { return request('ui/update-model-context', { content, structuredContent }); },\n    requestDisplayMode(mode) { return request('ui/request-display-mode', { mode }); },\n    openLink(url) { return request('ui/open-link', { url }); },\n    say(text) { return request('ui/message', { role: 'user', content: [{ type: 'text', text }] }); },\n  };\n})();\n\n// Small shared helpers for the cards.\nconst $ = (sel, el = document) => el.querySelector(sel);\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\nconst usd = (n, cur = 'USD') => new Intl.NumberFormat('en-US', { style: 'currency', currency: cur, minimumFractionDigits: Number.isInteger(Math.round(n * 100) / 100) ? 0 : 2 }).format(n || 0);\nconst cap = (s) => String(s || '').charAt(0).toUpperCase() + String(s || '').slice(1);\nconst ICONS = {\n  cleaning: '<path d=\"M14 3 9 13M7 13h6l3 8H4l3-8Z\"/><path d=\"M18 4v3M16.5 5.5h3\"/>',\n  catering: '<path d=\"M4 16h16M5 16a7 7 0 0 1 14 0M12 7V5.5M10.5 5.5h3M3 19h18\"/>',\n  plumbing: '<path d=\"M4 10h8a3 3 0 0 1 3 3v2h3v-5h2v9h-2v-2h-5v-2a1 1 0 0 0-1-1H4Z\"/><path d=\"M8 10V6M6 6h4\"/>',\n  handyman: '<path d=\"M14.5 6.5a4 4 0 0 0 4.9 4.9L21 13l-8 8-3-3 8-8-1.6-1.6a4 4 0 0 0-4.9-4.9l2.5 2.5-1.4 1.4Z\"/><path d=\"M3 21l6-6\"/>',\n  product: '<path d=\"M4 8 12 4l8 4v8l-8 4-8-4Z\"/><path d=\"M4 8l8 4 8-4M12 12v8\"/>',\n  check: '<path d=\"M5 12.5 10 17 19 7\"/>',\n};\nconst icon = (k) => `<span class=\"ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\">${ICONS[k] || ICONS.product}</svg></span>`;\nconst kindIcon = (o) => icon(o.kind === 'product' ? 'product' : o.category || guessCategory(o));\nfunction guessCategory(o) {\n  const t = `${o.merchant || ''} ${o.title || o.label || ''}`.toLowerCase();\n  if (/clean|maid|tidy|nest/.test(t)) return 'cleaning';\n  if (/cater|dinner|kitchen|table|chef|olive/.test(t)) return 'catering';\n  if (/plumb|leak|pipe/.test(t)) return 'plumbing';\n  if (/handy|fix|mount/.test(t)) return 'handyman';\n  return 'product';\n}\n// Budget gauge: spent, held, and (optional) what this plan would add.\nfunction gauge(env, { adding = 0, after = null } = {}) {\n  if (!env) return '';\n  const pct = (x) => Math.max(0, Math.min(100, (x / env.budget) * 100));\n  const left = after ?? env.remaining;\n  return `<div class=\"gauge\" role=\"img\" aria-label=\"${esc(usd(left))} left of ${esc(usd(env.budget))}\">\n    <div class=\"bar\"><span class=\"spent\" style=\"width:${pct(env.spent)}%\"></span><span class=\"held\" style=\"width:${pct(env.held)}%\"></span>${adding ? `<span class=\"next\" style=\"width:${pct(adding)}%\"></span>` : ''}</div>\n    <div class=\"gauge-text\"><span><b>${usd(left)}</b> left${after !== null ? ' after this' : ''} · ${esc(env.purpose || '')}</span><span>of ${usd(env.budget)}${env.period && env.period !== 'once' ? ' this ' + esc({ weekly: 'week', monthly: 'month' }[env.period] || env.period) : ''}</span></div>\n  </div>`;\n}\nfunction showError(result) {\n  const text = (result.content || []).map((c) => c.text).join(' ').replace(/\\s*Next step:.*$/, '');\n  document.body.innerHTML = `<main class=\"card\"><div class=\"head\"><p class=\"eyebrow\">Mandat</p><span class=\"pill wait\">Not done</span></div><h1>${esc(text)}</h1></main>`;\n}\n\nlet current = null;\nfunction render(result) {\n  if (result.isError) return showError(result);\n  const sc = result.structuredContent || {};\n  const plan = sc.plan; if (!plan) return;\n  current = sc;\n  const b = plan.breakdown;\n  const n = plan.lines.length;\n  const booked = plan.status === 'confirmed';\n  const pill = booked ? '<span class=\"pill ok\">Booked</span>' : plan.auto_approved ? '<span class=\"pill ok\">Within your rule</span>' : '<span class=\"pill wait\">Needs your yes</span>';\n  const env = sc.envelope;\n  $('#app').innerHTML = `\n    <div class=\"head\"><p class=\"eyebrow\">${esc(plan.purpose || 'Plan')}<span class=\"sep\"></span>${booked ? 'Payment holds placed' : 'Plan to approve'}</p>${pill}</div>\n    <div class=\"hero\">\n      <h1>${n} ${n === 1 ? 'item' : 'items'}, one ${booked ? 'approval' : 'yes'}</h1>\n      <span class=\"num\">${usd(b.total)}</span>\n    </div>\n    <ul class=\"rows\">${plan.lines.map((l) => `<li>${kindIcon(l)}<span class=\"who\"><b>${esc(l.merchant)}</b><span>${l.kind === 'product' ? `${esc(l.title)} · ${esc(l.detail || '')}` : `${esc(l.detail || '')}${l.guests ? ` · ${l.guests} guests` : ''}`}</span>${l.kind === 'product' ? '' : `<span class=\"long\">${esc(l.title)}</span>`}</span><span class=\"amt\">${l.discount ? `<s>${usd(l.base + (l.fees || 0))}</s>` : ''}${usd(l.total)}</span></li>`).join('')}</ul>\n    <div class=\"breakdown\"><span>Base <b>${usd(b.base)}</b></span>${b.discount ? `<span>Negotiated <b class=\"good\">−${usd(b.discount)}</b></span>` : ''}<span>Fees <b>${usd(b.fees)}</b></span><span>Tax <b>${usd(b.tax)}</b></span><span>Total <b>${usd(b.total)}</b></span></div>\n    <div class=\"foot\">\n      <div class=\"actions\" id=\"actions\">${booked ? `<span class=\"done\"><svg viewBox=\"0 0 24 24\">${ICONS.check}</svg>Booked. Nothing is charged until it is done.</span>` :\n        `<button class=\"primary\" id=\"approve\">${plan.auto_approved ? 'Buy now' : 'Approve ' + usd(b.total)}</button><button class=\"ghost\" id=\"expand\">Details</button><button class=\"ghost\" id=\"back\">Back</button>`}</div>\n      ${env ? gauge(env, booked ? {} : { adding: b.total, after: plan.remaining_after ?? null }) : ''}\n    </div>`;\n  const a = $('#approve');\n  if (a) a.onclick = async () => {\n    a.disabled = true; a.textContent = 'Placing holds…';\n    try {\n      const r = await mcpApp.callTool('confirm_plan', { plan_id: plan.id, confirmation_token: current.confirmation_token, user_confirmation: 'tap:approve' });\n      if (r.isError) { a.disabled = false; a.textContent = 'Try again'; $('#actions').insertAdjacentHTML('beforeend', `<p class=\"note\">${esc((r.content || []).map((c) => c.text).join(' '))}</p>`); return; }\n      plan.status = 'confirmed';\n      const env2 = r.structuredContent && r.structuredContent.receipt && r.structuredContent.receipt.envelope;\n      render({ structuredContent: { ...current, plan, envelope: env2 || current.envelope } });\n    } catch (e) { a.disabled = false; a.textContent = 'Try again'; }\n  };\n  const x = $('#expand'); if (x) x.onclick = () => mcpApp.requestDisplayMode('fullscreen').catch(() => {});\n  const bk = $('#back'); if (bk) bk.onclick = () => mcpApp.requestDisplayMode('inline').catch(() => {});\n}\nmcpApp.on('result', render);\nmcpApp.connect('mandat-plan');\n</script></body></html>\n"}]}}
